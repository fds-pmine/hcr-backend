# Rotation for the usage log.
#
#   sudo install -m0644 deploy/hcr-usage.logrotate /etc/logrotate.d/hcr-usage
#
# The service has no rotation of its own on purpose: every row carries an epoch
# `ts`, so bucketing by day is a property of the data rather than of the
# filename, and logrotate is already on the box and better at this.
#
# `copytruncate` because hcr-server holds the file open for the life of the
# process. Without it, rotation renames the file and a naive writer keeps
# appending to the renamed inode — the classic silent-loss failure, whose only
# symptom is a zero-byte log nobody notices for a month.
#
# The server no longer depends on this: it compares its descriptor against the
# path before every write and reopens if rotation moved the file underneath it.
# `copytruncate` is kept because it is the cheaper path — the inode survives, so
# there is nothing to reopen — but the correctness of the log no longer rests on
# a config file the program cannot see. If you replace this file with your own,
# the log still works.

/var/lib/hcr/usage.jsonl {
	daily
	rotate 90
	compress
	delaycompress
	missingok
	notifempty
	copytruncate
	create 0640 hcr hcr
}
