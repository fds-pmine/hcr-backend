# Copy to /etc/hcr-server.env, fill in the key, and chmod 0640 root:hcr.
# This file holds a secret — it must not be world-readable and must not be
# committed.

# Signs the itemRef tokens that bind an adaptive session's item to its response.
# Generate with:  openssl rand -hex 32
#
# Must be STABLE across restarts. Rotating it invalidates every reference in
# flight, so a deploy would break sessions that were mid-flight. At least 32
# bytes; the server refuses to start without it.
HCR_SIGNING_KEY=replace-me-openssl-rand-hex-32

# Loopback, because Caddy terminates TLS in front. Do not expose this port
# directly: the server speaks plain HTTP and has no authentication layer.
HCR_BIND=127.0.0.1:18623

# Browser origins allowed to call this API, comma-separated. Only an origin on
# the list is echoed back. Absent means no CORS headers at all, which would
# break the frontend on its own hostname.
#
# `hcr://app` is the desktop build. It serves its bundle over a registered
# scheme rather than file://, because file:// sends `Origin: null` — the same
# value any sandboxed frame on the web sends, and so not something an API can
# allow without allowing all of them. Drop it if you do not ship the desktop app.
HCR_CORS_ORIGIN=https://web.hcr.rs,hcr://app

# Append-only usage log — the response data item calibration needs, and the
# record of how the thing is actually used. Omit the line to collect nothing.
# See crates/hcr/src/usage.rs for exactly what each row contains.
HCR_USAGE_LOG=/var/lib/hcr/usage.jsonl
